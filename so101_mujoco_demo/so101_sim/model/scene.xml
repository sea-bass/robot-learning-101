<mujoco model="so101_pick_cube">
  <!-- two cubes (red, green): the task is to pick the one named by the language instruction -->
  <include file="so101_new_calib.xml"/>

  <!-- elliptic cone + high impratio: crucial for stable pinch grasps -->
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.02 0.02 0.02" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.32 0.4" rgb2="0.15 0.2 0.28" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="cube_red" rgba="0.9 0.25 0.2 1"/>
    <material name="cube_green" rgba="0.2 0.75 0.25 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light pos="0.6 -0.4 1.0" dir="-0.5 0.4 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" friction="1.0 0.005 0.0001"/>

    <body name="cube_red" pos="0.25 -0.06 0.0125">
      <freejoint name="cube_red_free"/>
      <geom name="cube_red" type="box" size="0.0125 0.0125 0.0125" material="cube_red" mass="0.02" friction="0.8 0.01 0.0001" condim="4"/>
    </body>
    <body name="cube_green" pos="0.25 0.03 0.0125">
      <freejoint name="cube_green_free"/>
      <geom name="cube_green" type="box" size="0.0125 0.0125 0.0125" material="cube_green" mass="0.02" friction="0.8 0.01 0.0001" condim="4"/>
    </body>

    <camera name="front" pos="0.5 -0.4 0.32" xyaxes="0.819 0.573 0 -0.284 0.405 0.863" fovy="42"/>
  </worldbody>

  <keyframe>
    <key name="home"
         qpos="0 -0.5 0.8 0.6 0 0.5  0.25 -0.06 0.0125 1 0 0 0  0.25 0.03 0.0125 1 0 0 0"
         ctrl="0 -0.5 0.8 0.6 0 0.5"/>
  </keyframe>
</mujoco>
